# emulator_top.ucf
# Constraints for the Digilent Spartan-3 Starter Board (XC3S200, package FT256)

# 50 MHz clock
NET "clk" LOC = "T9";
NET "clk" TNM_NET = "clk";
TIMESPEC "TS_clk" = PERIOD "clk" 20 ns HIGH 50 %;

# Reset: push button BTN3
NET "rst" LOC = "L14";

# Serial port RS-232 (DB9 connector)
NET "rxd" LOC = "T13";
NET "txd" LOC = "R13";

# Slide switches SW0, SW1: select what the LEDs show
NET "sw<0>" LOC = "F12";
NET "sw<1>" LOC = "G12";

# LEDs LD0..LD7
NET "led<0>" LOC = "K12";
NET "led<1>" LOC = "P14";
NET "led<2>" LOC = "L12";
NET "led<3>" LOC = "N14";
NET "led<4>" LOC = "P13";
NET "led<5>" LOC = "N12";
NET "led<6>" LOC = "P12";
NET "led<7>" LOC = "P11";
